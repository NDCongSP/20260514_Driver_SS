<Project Sdk="Microsoft.NET.Sdk">

  <!--
  ============================================================
  Scale_DIGI — Parser can DIGI (format: "3.08@=")
  ============================================================
  netstandard2.0: tuong thich voi .NET Framework 4.7.2, .NET 6, .NET 8
  Khong can doi target khi dung o project WinForms hoac WPF bat ky.

  Cach dung: ScanAndScale.Core tu dong load DLL nay tai runtime
  qua Reflection khi ScaleConfig.ModelName = "Scale_DIGI".
  DLL nay KHONG can duoc reference thu cong - chi can nam cung thu muc .exe
  ============================================================
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>Scale_DIGI</AssemblyName>
    <RootNamespace>Scale_DIGI</RootNamespace>
    <Description>Parser can DIGI - format: 3.08@=</Description>
    <Version>1.0.1</Version>
    <NugetUrl>http://10.40.10.4:5860/v3/index.json</NugetUrl>
    <NugetKey>11EA37E236F449A3A10B188194A5C111</NugetKey>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PushToNuget>false</PushToNuget>
  </PropertyGroup>

  <Target Name="CopyNupkgLocal" Condition="$(PushToNuget) == 'true' And $(GeneratePackageOnBuild) == 'true'" AfterTargets="Pack">
    <!-- Publish nuget package -->
    <Message Importance="high" Text="dotnet nuget push -s $(NugetUrl) bin\Debug\$(MSBuildProjectName).$(Version).nupkg -k $(NugetKey)"></Message>
    <Exec Command="dotnet nuget push -s $(NugetUrl) bin\Debug\$(MSBuildProjectName).$(Version).nupkg -k $(NugetKey)" ContinueOnError="true" />
  </Target>

</Project>
