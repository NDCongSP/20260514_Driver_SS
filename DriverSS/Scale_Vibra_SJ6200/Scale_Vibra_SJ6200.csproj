<Project Sdk="Microsoft.NET.Sdk">

  <!--
  ============================================================
  Scale_Vibra_SJ6200 - Parser can Vibra SJ-6200
  ============================================================
  netstandard2.0: tuong thich voi .NET Framework 4.7.2, .NET 6, .NET 8

  Cach dung: ScanAndScale.Core tu dong load DLL nay tai runtime
  qua Reflection khi ScaleConfig.ModelName = "Scale_Vibra_SJ6200".
  ============================================================
